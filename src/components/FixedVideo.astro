---
interface Props {
  video: string;
  position?: 'right' | 'center' | 'left' | 'center-right' | 'moving';
}

const { video, position = 'right' } = Astro.props;

const positionStyles = {
  right: 'right-0',
  center: 'left-1/2 -translate-x-1/2',
  left: 'left-0',
  'center-right': 'right-[25%]',
  moving: 'video-moving',
};
---

<div class:list={["fixed bottom-0 z-40 pointer-events-none", positionStyles[position]]} style="mask-image: radial-gradient(ellipse 70% 75% at 50% 50%, black 20%, transparent 60%); -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 50%, black 20%, transparent 60%);">
  <video
    autoplay
    loop
    muted
    playsinline
    class="w-48 sm:w-56 lg:w-72 h-auto block"
  >
    <source src={video} type="video/mp4" />
  </video>
</div>

{position === 'moving' && (
  <script>
    const movingVideo = document.querySelector('.video-moving') as HTMLElement;
    if (movingVideo) {
      let x = Math.random() * (window.innerWidth - 288);
      const isMobile = window.innerWidth < 1024;
      const topLimit = isMobile ? 80 : 200;
      const w = isMobile ? 192 : 288;
      const h = isMobile ? 140 : 200;
      let y = topLimit + Math.random() * (window.innerHeight - h - topLimit);
      let dx = (Math.random() * 0.4 + 0.3) * (Math.random() > 0.5 ? 1 : -1);
      let dy = (Math.random() * 0.3 + 0.2) * (Math.random() > 0.5 ? 1 : -1);

      movingVideo.style.left = x + 'px';
      movingVideo.style.top = y + 'px';
      movingVideo.style.bottom = 'auto';

      // Keep video playing on mobile
      const vid = movingVideo.querySelector('video') as HTMLVideoElement;
      if (vid) {
        document.addEventListener('visibilitychange', () => {
          if (!document.hidden) vid.play();
        });
        vid.addEventListener('pause', () => {
          setTimeout(() => { if (vid.paused) vid.play(); }, 100);
        });
      }

      function animate() {
        x += dx;
        y += dy;

        if (x <= 0 || x >= window.innerWidth - w) dx = -dx;
        if (y <= topLimit || y >= window.innerHeight - h) dy = -dy;

        x = Math.max(0, Math.min(x, window.innerWidth - w));
        y = Math.max(topLimit, Math.min(y, window.innerHeight - h));

        movingVideo.style.left = x + 'px';
        movingVideo.style.top = y + 'px';

        requestAnimationFrame(animate);
      }
      animate();
    }
  </script>
)}
