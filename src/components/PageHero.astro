---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="py-12 lg:py-16 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4">
    <!-- Desktop: video na pozadí, nadpis překrývá levou část -->
    <div class="hero-banner relative hidden lg:block rounded-3xl overflow-hidden max-w-4xl mx-auto">
      <!-- Video jako pozadí celého banneru, omezená šířka -->
      <video
        class="w-full h-auto block"
        autoplay
        loop
        muted
        playsinline
      >
        <source src="/videos/animace-panacci.mp4" type="video/mp4" />
      </video>
      <!-- Nadpis překrývající levou část videa -->
      <div class="absolute inset-0 flex items-center z-10">
        <div class="pl-8 lg:pl-12 max-w-[55%]">
          <h1 class="text-5xl xl:text-6xl font-display font-900 bg-gradient-to-r from-pink-400 via-purple-300 to-cyan-400 bg-clip-text text-transparent drop-shadow-[0_2px_20px_rgba(0,0,0,0.8)]">
            {title}
          </h1>
          {subtitle && (
            <p class="mt-4 text-lg text-white/70 max-w-xl drop-shadow-[0_1px_10px_rgba(0,0,0,0.8)]">{subtitle}</p>
          )}
        </div>
      </div>
    </div>

    <!-- Mobile: jen nadpis, bez panáčků -->
    <div class="lg:hidden text-center">
      <h1 class="text-5xl font-display font-900 bg-gradient-to-r from-pink-400 via-purple-300 to-cyan-400 bg-clip-text text-transparent">
        {title}
      </h1>
      {subtitle && (
        <p class="mt-4 text-lg text-white/60 max-w-2xl mx-auto">{subtitle}</p>
      )}
    </div>
  </div>
</section>
