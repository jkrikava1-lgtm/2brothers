---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="py-12 lg:py-16 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4">
    <!-- Desktop: nadpis vlevo (se stejným pozadím jako video), video vpravo = jeden blok -->
    <div class="hero-banner hidden lg:flex items-stretch rounded-[2rem] overflow-hidden border border-white/5 shadow-[0_0_40px_rgba(255,26,126,0.1)] max-w-4xl mx-auto">
      <!-- Levá část: nadpis na stejném pozadí jako video -->
      <div class="flex items-center justify-end flex-shrink-0 px-8" style="background-color: #180f2f; width: 35%;">
        <div class="text-right">
          <h1 class="text-5xl xl:text-6xl font-display font-900 bg-gradient-to-r from-pink-400 via-purple-300 to-cyan-400 bg-clip-text text-transparent">
            {title}
          </h1>
          {subtitle && (
            <p class="mt-3 text-base text-white/70">{subtitle}</p>
          )}
        </div>
      </div>
      <!-- Pravá část: video s panáčky (panáčci vybíhají "zpoza" nadpisu) -->
      <div class="flex-1" style="background-color: #180f2f;">
        <video
          class="w-full h-auto block"
          autoplay
          loop
          muted
          playsinline
        >
          <source src="/videos/animace-panacci.mp4" type="video/mp4" />
        </video>
      </div>
    </div>

    <!-- Mobile: jen nadpis, bez panáčků -->
    <div class="lg:hidden text-center">
      <h1 class="text-5xl font-display font-900 bg-gradient-to-r from-pink-400 via-purple-300 to-cyan-400 bg-clip-text text-transparent">
        {title}
      </h1>
      {subtitle && (
        <p class="mt-4 text-lg text-white/60 max-w-2xl mx-auto">{subtitle}</p>
      )}
    </div>
  </div>
</section>
