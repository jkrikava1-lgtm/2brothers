---
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/favicon.png" />
</head>
<body class="min-h-screen flex flex-col">

  <!-- Header -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-night-950">
    <div class="max-w-6xl mx-auto px-4 h-32 lg:h-40 flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="flex flex-col items-center">
          <img src="/images/logo.png" alt="2Brothers Music Factory" class="h-24 lg:h-32 w-auto" />
          <span class="text-[10px] lg:text-xs font-bold tracking-[0.3em] text-white/60 uppercase -mt-1">Music Factory</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1">
        {site.nav_items.map((item: { label: string; href: string }) => (
          <a
            href={item.href}
            class:list={[
              'px-4 py-2 rounded-lg text-sm font-semibold transition-all',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-pink-400 bg-pink-500/15'
                : 'text-white/70 hover:text-white hover:bg-white/5'
            ]}
          >
            {item.label}
          </a>
        ))}
        <a href="/kontakt" class="ml-3 px-5 py-2.5 bg-gradient-to-r from-pink-500 to-purple-500 hover:from-pink-400 hover:to-purple-400 text-white rounded-full text-sm font-bold transition-all hover:scale-105 hover:shadow-lg hover:shadow-pink-500/30">
          Napište nám
        </a>
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="mobile-toggle"
        class="lg:hidden w-10 h-10 flex items-center justify-center text-white/80 hover:text-white"
        aria-label="Otevřít menu"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Nav -->
    <div id="mobile-nav" class="lg:hidden hidden bg-night-950/95 backdrop-blur-xl">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-1">
        {site.nav_items.map((item: { label: string; href: string }) => (
          <a
            href={item.href}
            class:list={[
              'px-4 py-3 rounded-lg text-base font-semibold transition-colors',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-pink-400 bg-pink-500/15'
                : 'text-white/70 hover:text-white hover:bg-white/5'
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <!-- Main -->
  <main class="flex-1 pt-32 lg:pt-40">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="relative overflow-hidden">
    <div class="relative max-w-6xl mx-auto px-4 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Brand -->
        <div>
          <a href="/" class="inline-block">
            <img src="/images/logo.png" alt="2Brothers Music Factory" class="h-20 w-auto" />
            <span class="block text-[10px] font-bold tracking-[0.3em] text-white/50 uppercase text-center -mt-1">Music Factory</span>
          </a>
          <p class="text-white/50 text-sm">{site.tagline}</p>
          <p class="text-white/40 text-sm mt-2">{site.locations.join(' · ')}</p>
        </div>

        <!-- Contact -->
        <div>
          <h4 class="text-sm font-bold text-pink-400 uppercase tracking-wider mb-3">Kontakt</h4>
          <div class="space-y-1.5 text-sm text-white/50">
            <p>Jiří Samšiňák: <a href={`tel:${site.phone_jiri.replace(/\s/g, '')}`} class="text-white/80 hover:text-pink-400 transition-colors">{site.phone_jiri}</a></p>
            <p>Jakub Křikava: <a href={`tel:${site.phone_jakub.replace(/\s/g, '')}`} class="text-white/80 hover:text-pink-400 transition-colors">{site.phone_jakub}</a></p>
            <p><a href={`mailto:${site.email}`} class="text-white/80 hover:text-pink-400 transition-colors">{site.email}</a></p>
          </div>
        </div>

        <!-- Nav -->
        <div>
          <h4 class="text-sm font-bold text-cyan-400 uppercase tracking-wider mb-3">Navigace</h4>
          <div class="space-y-1.5">
            {site.nav_items.map((item: { label: string; href: string }) => (
              <a href={item.href} class="block text-sm text-white/50 hover:text-pink-400 transition-colors">
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-10 pt-6 border-t border-white/10 text-center text-xs text-white/30">
        {site.footer_text}
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('mobile-toggle');
    const nav = document.getElementById('mobile-nav');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    toggle?.addEventListener('click', () => {
      const isOpen = !nav?.classList.contains('hidden');
      nav?.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
      toggle.setAttribute('aria-label', isOpen ? 'Otevřít menu' : 'Zavřít menu');
    });
  </script>
</body>
</html>
