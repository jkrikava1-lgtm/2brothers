---
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="seznam-wmt" content="3Wl2QDajexE7HptU9p8q2i8nvMGpTHZH" />
  <!-- Google Analytics - loaded only after cookie consent -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    if (localStorage.getItem('cookies-accepted') === 'true') {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-WH3GQ8KLXL';
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', 'G-WH3GQ8KLXL');
    }
  </script>
</head>
<body class="min-h-screen flex flex-col relative overflow-x-hidden">

  <!-- Global glow orbs -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute top-[5%] left-[5%] w-[200px] sm:w-[500px] h-[200px] sm:h-[500px] bg-pink-500/20 sm:bg-pink-500/15 rounded-full blur-[80px] sm:blur-[150px]"></div>
    <div class="absolute top-[30%] right-[0%] w-[180px] sm:w-[400px] h-[180px] sm:h-[400px] bg-cyan-400/15 sm:bg-cyan-400/10 rounded-full blur-[70px] sm:blur-[130px]"></div>
    <div class="absolute top-[55%] left-[20%] w-[160px] sm:w-[350px] h-[160px] sm:h-[350px] bg-purple-500/15 sm:bg-purple-500/10 rounded-full blur-[60px] sm:blur-[120px]"></div>
    <div class="absolute top-[75%] right-[10%] w-[200px] sm:w-[450px] h-[200px] sm:h-[450px] bg-pink-500/15 sm:bg-pink-500/10 rounded-full blur-[70px] sm:blur-[140px]"></div>
    <div class="absolute top-[90%] left-[5%] w-[150px] sm:w-[300px] h-[150px] sm:h-[300px] bg-cyan-400/12 sm:bg-cyan-400/8 rounded-full blur-[50px] sm:blur-[100px]"></div>
  </div>

  <!-- Header -->
  <header class="fixed top-0 left-0 right-0 z-50 overflow-visible pb-16 sm:pb-20" style="mask-image: linear-gradient(to bottom, black 55%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 100%);">
    <!-- Header glow -->
    <div class="absolute inset-0 bg-night-950"></div>
    <div class="absolute -top-20 -left-20 w-[150px] sm:w-[300px] h-[150px] sm:h-[300px] bg-pink-500/20 sm:bg-pink-500/15 rounded-full blur-[60px] sm:blur-[100px]"></div>
    <div class="absolute -top-10 right-[20%] w-[300px] h-[300px] bg-pink-500/12 rounded-full blur-[100px] hidden sm:block"></div>
    <div class="absolute -top-10 right-[5%] w-[250px] h-[250px] bg-purple-500/10 rounded-full blur-[80px] hidden sm:block"></div>
    <div class="absolute -bottom-10 right-0 w-[100px] sm:w-[200px] h-[100px] sm:h-[200px] bg-purple-500/12 sm:bg-cyan-400/8 rounded-full blur-[40px] sm:blur-[80px]"></div>
    <div class="relative max-w-7xl mx-auto px-4 h-20 sm:h-28 lg:h-48 flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="relative">
          <div class="absolute inset-x-0 -bottom-[80%] top-[10%] bg-pink-500/25 rounded-full blur-[50px] sm:blur-[90px] scale-x-150"></div>
          <div class="absolute top-1/2 -right-[100%] -translate-y-1/2 w-[400px] h-[200px] bg-pink-500/15 rounded-full blur-[80px] hidden lg:block"></div>
          <img src="/images/logo.webp" alt="2Brothers Music Factory" class="relative h-16 sm:h-24 lg:h-44 w-auto logo-glow" />
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-2">
        {site.nav_items.map((item: { label: string; href: string }) => (
          <a
            href={item.href}
            class:list={[
              'px-5 py-2.5 rounded-full text-sm font-bold transition-all border',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-white bg-pink-600/30 border-pink-400/60 shadow-[0_0_30px_rgba(255,50,100,0.6),0_0_60px_rgba(255,50,100,0.2)]'
                : 'text-pink-200 bg-pink-500/10 border-pink-500/25 shadow-[0_0_12px_rgba(255,26,126,0.25)] hover:bg-pink-500/20 hover:shadow-[0_0_18px_rgba(255,26,126,0.35)] hover:text-white'
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="mobile-toggle"
        class="lg:hidden w-10 h-10 flex items-center justify-center text-white/80 hover:text-white"
        aria-label="Otevřít menu"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Nav -->
    <div id="mobile-nav" class="lg:hidden hidden bg-night-950/95 backdrop-blur-xl relative">
      <nav class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1">
        {site.nav_items.map((item: { label: string; href: string }) => (
          <a
            href={item.href}
            class:list={[
              'px-5 py-3 rounded-full text-base font-bold transition-all border',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-white bg-pink-600/30 border-pink-400/60 shadow-[0_0_30px_rgba(255,50,100,0.6),0_0_60px_rgba(255,50,100,0.2)]'
                : 'text-pink-200 bg-pink-500/10 border-pink-500/25 shadow-[0_0_12px_rgba(255,26,126,0.25)] hover:bg-pink-500/20 hover:shadow-[0_0_18px_rgba(255,26,126,0.35)] hover:text-white'
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <!-- Main -->
  <main class="flex-1 pt-20 sm:pt-24 lg:pt-38 relative z-10">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="relative z-10 overflow-visible" style="mask-image: linear-gradient(to top, black 70%, transparent 100%); -webkit-mask-image: linear-gradient(to top, black 70%, transparent 100%);">
    <div class="relative max-w-7xl mx-auto px-4 py-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Brand -->
        <div>
          <a href="/" class="inline-block relative">
            <div class="absolute inset-0 bg-pink-500/20 rounded-full blur-[30px] sm:blur-[40px] scale-150"></div>
            <img src="/images/logo.webp" alt="2Brothers Music Factory" class="relative h-16 sm:h-24 w-auto mb-3" style="filter: drop-shadow(0 0 8px rgba(255,50,100,0.7)) drop-shadow(0 0 20px rgba(255,50,100,0.4)) brightness(1.15);" />
          </a>
          <p class="text-white/50 text-sm">{site.tagline}</p>
          <p class="text-white/40 text-sm mt-2">Přijedeme za vámi kamkoli</p>
        </div>

        <!-- Contact -->
        <div>
          <h4 class="text-sm font-bold text-pink-400 uppercase tracking-wider mb-3">Kontakt</h4>
          <div class="space-y-1.5 text-sm text-white/50">
            <p>Jiří Samšiňák: <a href={`tel:${site.phone_jiri.replace(/\s/g, '')}`} class="text-white/80 hover:text-pink-400 transition-colors">{site.phone_jiri}</a></p>
            <p>Jakub Křikava: <a href={`tel:${site.phone_jakub.replace(/\s/g, '')}`} class="text-white/80 hover:text-pink-400 transition-colors">{site.phone_jakub}</a></p>
            <p><a href={`mailto:${site.email}`} class="text-white/80 hover:text-pink-400 transition-colors">{site.email}</a></p>
          </div>
        </div>

        <!-- Nav -->
        <div>
          <h4 class="text-sm font-bold text-cyan-400 uppercase tracking-wider mb-3">Navigace</h4>
          <div class="space-y-1.5">
            {site.nav_items.map((item: { label: string; href: string }) => (
              <a href={item.href} class="block text-sm text-white/50 hover:text-pink-400 transition-colors">
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-white/10 text-center text-xs text-white/30">
        {site.footer_text}
      </div>
      <div class="mt-2 text-center text-xs text-white/20">
        Web vytvořil <a href="https://hezkewebovky.cz" target="_blank" rel="noopener" class="hover:text-white/60 transition-colors">hezkewebovky.cz</a>
      </div>
    </div>
  </footer>

  <!-- Cookie consent banner -->
  <div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-50 px-4 py-4 bg-night-950/95 backdrop-blur-xl border-t border-white/10" style="display:none;">
    <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center gap-4 text-sm">
      <p class="text-white/60 text-center sm:text-left flex-1">Používáme cookies pro analýzu návštěvnosti. Žádné reklamní cookies nepoužíváme.</p>
      <div class="flex items-center gap-4 shrink-0">
        <button id="cookie-settings" class="text-white/40 hover:text-white/70 underline underline-offset-2 transition-all text-sm">Nastavení</button>
        <button id="cookie-accept" class="px-6 py-2 rounded-full bg-pink-500 hover:bg-pink-400 text-white font-bold transition-all text-sm whitespace-nowrap">Přijmout vše</button>
      </div>
    </div>
  </div>

  <!-- Cookie modal -->
  <div id="cookie-modal" class="fixed inset-0 z-[200] hidden">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <div class="absolute bottom-0 left-0 right-0 sm:bottom-auto sm:top-1/2 sm:-translate-y-1/2 sm:left-1/2 sm:-translate-x-1/2 sm:w-full sm:max-w-lg bg-night-950 border border-white/10 sm:rounded-xl shadow-2xl p-6">
      <div class="flex items-start justify-between mb-1">
        <h3 class="text-xl font-bold text-white">Nastavení cookies</h3>
        <span class="text-xs text-white/30 pt-1.5"><span id="active-count">2</span> z 2 aktivní</span>
      </div>
      <p class="text-sm text-white/50 mb-6">Vyberte, které cookies povolíte. Nezbytné jsou vždy aktivní.</p>
      <div class="space-y-4 mb-6">
        <div class="flex items-start justify-between gap-4 py-3 border-b border-white/10">
          <div>
            <p class="text-sm font-semibold text-white/80">Nezbytné</p>
            <p class="text-xs text-white/30 mt-0.5">Zajišťují základní funkce webu. Nelze vypnout.</p>
          </div>
          <div class="flex-shrink-0 w-10 h-6 bg-pink-500 rounded-full opacity-40 cursor-not-allowed relative mt-0.5">
            <div class="absolute right-1 top-1 w-4 h-4 bg-white rounded-full"></div>
          </div>
        </div>
        <div class="flex items-start justify-between gap-4 py-3">
          <div class="flex-1">
            <p class="text-sm font-semibold text-white/80">Analytické <span class="text-xs text-pink-400 font-normal ml-1">(doporučeno)</span></p>
            <p class="text-xs text-white/30 mt-0.5">Google Analytics — pomáhají nám zlepšovat web.</p>
            <p id="analytics-warning" class="hidden text-xs text-amber-400/80 mt-1.5">Bez analytiky nemůžeme sledovat, co vám chybí, a web zlepšovat pro vás.</p>
          </div>
          <button id="toggle-analytics" role="switch" aria-checked="true"
            class="flex-shrink-0 w-10 h-6 rounded-full transition-colors duration-200 bg-pink-500 relative mt-0.5">
            <div id="toggle-knob" class="absolute top-1 w-4 h-4 bg-white rounded-full shadow transition-all duration-200 right-1"></div>
          </button>
        </div>
      </div>
      <div id="normal-buttons">
        <div class="flex gap-3">
          <button id="cookie-save" class="flex-1 py-2.5 text-sm font-bold text-white bg-pink-500 hover:bg-pink-400 rounded-full transition-all">Uložit nastavení</button>
          <button id="cookie-accept-all" class="flex-1 py-2.5 text-sm font-semibold text-white/70 bg-white/10 hover:bg-white/20 rounded-full transition-colors">Přijmout vše</button>
        </div>
      </div>
      <div id="confirm-area" class="hidden">
        <div class="bg-white/5 border border-white/10 rounded-xl p-4">
          <p class="text-sm text-white/60 text-center mb-3">Opravdu chcete omezit naše možnosti zlepšování webu?</p>
          <button id="confirm-accept" class="w-full py-2.5 text-sm font-bold text-white bg-pink-500 hover:bg-pink-400 rounded-full transition-colors mb-2">Přijmout doporučené cookies</button>
          <button id="confirm-reject" class="w-full py-1.5 text-xs text-white/25 hover:text-white/40 transition-colors">Pokračovat bez analytiky</button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      if (window.location.search.indexOf('reset-cookies') !== -1) {
        localStorage.removeItem('cookies-accepted');
        window.location.href = window.location.pathname;
        return;
      }
      var analyticsOn = true;
      var confirmStep = false;
      var banner = document.getElementById('cookie-banner');
      if (!localStorage.getItem('cookies-accepted')) { banner.style.display = 'block'; }

      function hideBanner() {
        banner.style.display = 'none';
        document.getElementById('cookie-modal').classList.add('hidden');
      }
      function loadGA() {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-WH3GQ8KLXL';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-WH3GQ8KLXL');
      }

      ['cookie-accept','cookie-accept-all'].forEach(function(id) {
        document.getElementById(id)?.addEventListener('click', function() {
          localStorage.setItem('cookies-accepted', 'true');
          hideBanner(); loadGA();
        });
      });
      document.getElementById('cookie-settings')?.addEventListener('click', function() {
        document.getElementById('cookie-modal').classList.remove('hidden');
      });
      document.getElementById('toggle-analytics')?.addEventListener('click', function() {
        analyticsOn = !analyticsOn;
        confirmStep = false;
        this.classList.toggle('bg-pink-500', analyticsOn);
        this.classList.toggle('bg-white/20', !analyticsOn);
        var k = document.getElementById('toggle-knob');
        k.classList.toggle('right-1', analyticsOn);
        k.classList.toggle('left-1', !analyticsOn);
        this.setAttribute('aria-checked', String(analyticsOn));
        var cnt = document.getElementById('active-count');
        if (cnt) cnt.textContent = analyticsOn ? '2' : '1';
        var warn = document.getElementById('analytics-warning');
        if (warn) warn.classList.toggle('hidden', analyticsOn);
        var saveBtn = document.getElementById('cookie-save');
        if (saveBtn) {
          if (analyticsOn) {
            saveBtn.textContent = 'Uložit nastavení';
            saveBtn.className = 'flex-1 py-2.5 text-sm font-bold text-white bg-pink-500 hover:bg-pink-400 rounded-full transition-all';
          } else {
            saveBtn.textContent = 'Uložit bez doporučených';
            saveBtn.className = 'flex-1 py-2.5 text-sm font-semibold text-white/30 bg-white/10 rounded-full transition-all';
          }
        }
        document.getElementById('confirm-area').classList.add('hidden');
        document.getElementById('normal-buttons').classList.remove('hidden');
      });
      document.getElementById('cookie-save')?.addEventListener('click', function() {
        if (analyticsOn) {
          localStorage.setItem('cookies-accepted', 'true');
          hideBanner(); loadGA();
          return;
        }
        if (!confirmStep) {
          confirmStep = true;
          document.getElementById('normal-buttons').classList.add('hidden');
          document.getElementById('confirm-area').classList.remove('hidden');
        }
      });
      document.getElementById('confirm-accept')?.addEventListener('click', function() {
        localStorage.setItem('cookies-accepted', 'true');
        hideBanner(); loadGA();
      });
      document.getElementById('confirm-reject')?.addEventListener('click', function() {
        localStorage.setItem('cookies-accepted', 'false');
        hideBanner();
      });
      document.getElementById('cookie-modal')?.addEventListener('click', function(e) {
        if (e.target === this || e.target === this.firstElementChild) hideBanner();
      });
    })();
  </script>

  <script>
    const toggle = document.getElementById('mobile-toggle');
    const nav = document.getElementById('mobile-nav');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    toggle?.addEventListener('click', () => {
      const isOpen = !nav?.classList.contains('hidden');
      nav?.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
      toggle.setAttribute('aria-label', isOpen ? 'Otevřít menu' : 'Zavřít menu');
    });
  </script>
</body>
</html>
