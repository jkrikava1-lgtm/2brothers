---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import data from '../data/o-nas.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero title={data.hero_title} subtitle={data.hero_subtitle} />

  <!-- Intro -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <p class="text-lg text-white/60 leading-relaxed">{data.intro}</p>
        <img src="/images/o-nas/smich.jpg" alt="2Brothers v akci" class="rounded-3xl w-full shadow-[0_0_40px_rgba(255,26,126,0.15)]" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Fotogalerie -->
  <section class="py-8">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <img src="/images/o-nas/foto-akce.jpg" alt="Akce 2Brothers" class="rounded-3xl w-full shadow-lg" loading="lazy" />
        <img src="/images/o-nas/vyjezdni-stan.jpg" alt="Výjezdní stan" class="rounded-3xl w-full shadow-lg" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="py-10 lg:py-14 relative overflow-hidden">
    <div class="absolute inset-0 bg-night-950"></div>
    <div class="absolute top-0 right-0 w-72 h-72 bg-cyan-400/10 rounded-full blur-[80px]"></div>

    <div class="relative max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="p-8 rounded-3xl bg-pink-500/5 border border-pink-500/20">
          <h2 class="text-3xl font-display mb-6 text-pink-400">{data.approach_headline}</h2>
          <p class="text-white/60 leading-relaxed">{data.approach_text}</p>
        </div>
        <div class="p-8 rounded-3xl bg-cyan-400/5 border border-cyan-400/20">
          <h2 class="text-3xl font-display mb-6 text-cyan-400">{data.genres_headline}</h2>
          <p class="text-white/60 leading-relaxed">{data.genres_text}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Events & Members -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Events -->
        <div>
          <h2 class="text-3xl font-display mb-8">{data.events_headline}</h2>
          <ul class="space-y-4">
            {data.events.map((event, i) => (
              <li class="flex items-center gap-4 text-white/70">
                <div class:list={[
                  'w-10 h-10 rounded-xl flex items-center justify-center shrink-0',
                  i % 2 === 0 ? 'bg-pink-500/15' : 'bg-cyan-400/15',
                ]}>
                  <svg class:list={['w-5 h-5', i % 2 === 0 ? 'text-pink-400' : 'text-cyan-400']} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                  </svg>
                </div>
                <span class="font-medium">{event}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Members -->
        <div>
          <h2 class="text-3xl font-display mb-8">Kdo za tím stojí</h2>
          <div class="space-y-6">
            {data.members.map((member, i) => (
              <div class:list={[
                'p-6 rounded-3xl border',
                i === 0 ? 'bg-gradient-to-r from-pink-500/10 to-pink-500/5 border-pink-500/20' : 'bg-gradient-to-r from-cyan-400/10 to-cyan-400/5 border-cyan-400/20',
              ]}>
                <h3 class="text-xl font-display font-800 mb-2">{member.name}</h3>
                <a href={`tel:${member.phone.replace(/\s/g, '')}`} class:list={[
                  'font-medium transition-colors',
                  i === 0 ? 'text-pink-400 hover:text-pink-300' : 'text-cyan-400 hover:text-cyan-300',
                ]}>
                  {member.phone}
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
