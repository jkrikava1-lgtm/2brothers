---
import Layout from '../layouts/Layout.astro';
import data from '../data/homepage.json';
---

<Layout title={data.meta_title} description={data.meta_description}>

  <!-- Hero -->
  <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
    <!-- Background gradient -->
    <div class="absolute inset-0 bg-gradient-to-b from-accent-900/30 via-dark-950 to-dark-950"></div>
    <!-- Decorative elements -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-accent-500/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 right-1/4 w-72 h-72 bg-gold-500/5 rounded-full blur-3xl"></div>

    <div class="relative max-w-4xl mx-auto px-4 text-center py-20">
      <img src="/images/hero/dj-duo.gif" alt="2Brothers DJ Duo" class="mx-auto mb-8 w-64 lg:w-80" />
      <h1 class="text-5xl lg:text-7xl font-display font-800 mb-6">
        <span class="bg-gradient-to-r from-light-50 via-accent-200 to-accent-400 bg-clip-text text-transparent">
          {data.hero_headline}
        </span>
      </h1>
      <p class="text-xl lg:text-2xl text-light-300 mb-10 max-w-2xl mx-auto">
        {data.hero_subheadline}
      </p>
      <a
        href={data.hero_cta_href}
        class="inline-flex items-center gap-2 px-8 py-4 bg-accent-500 hover:bg-accent-400 text-light-50 rounded-xl text-lg font-semibold transition-all hover:scale-105 hover:shadow-lg hover:shadow-accent-500/25"
      >
        {data.hero_cta}
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- About preview -->
  <section class="py-20 lg:py-28">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl lg:text-4xl font-display mb-6">{data.about_headline}</h2>
        <p class="text-lg text-light-300 leading-relaxed mb-8">{data.about_text}</p>
        <a href={data.about_cta_href} class="inline-flex items-center gap-2 text-accent-400 hover:text-accent-300 font-medium transition-colors">
          {data.about_cta}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 lg:py-28 bg-dark-900">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl lg:text-4xl font-display text-center mb-14">{data.services_headline}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {data.services.map((service) => (
          <div class="group p-8 rounded-2xl bg-dark-800 border border-dark-700/50 hover:border-accent-500/30 transition-all hover:shadow-lg hover:shadow-accent-500/5">
            <div class="w-12 h-12 rounded-xl bg-accent-500/10 flex items-center justify-center mb-5">
              {service.icon === 'heart' && (
                <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              )}
              {service.icon === 'cake' && (
                <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0A1.75 1.75 0 013 15.546V12a9 9 0 0118 0v3.546zM12 4v1m-4 1l.5-.87M16 6l-.5-.87" />
                </svg>
              )}
              {service.icon === 'briefcase' && (
                <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.193 23.193 0 0112 15c-3.183 0-6.22-.64-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              {service.icon === 'music' && (
                <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                </svg>
              )}
            </div>
            <h3 class="text-xl font-display font-700 mb-3 group-hover:text-accent-400 transition-colors">{service.title}</h3>
            <p class="text-light-400 leading-relaxed">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Equipment -->
  <section class="py-20 lg:py-28">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl lg:text-4xl font-display text-center mb-14">{data.equipment_headline}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-3xl mx-auto">
        {data.equipment_items.map((item) => (
          <div class="flex items-center gap-3 p-4 rounded-xl bg-dark-800 border border-dark-700/50">
            <svg class="w-5 h-5 text-gold-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-sm text-light-200">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 lg:py-28 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-accent-900/20 via-accent-800/10 to-accent-900/20"></div>
    <div class="relative max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl lg:text-4xl font-display mb-6">{data.cta_headline}</h2>
      <p class="text-lg text-light-300 mb-10">{data.cta_text}</p>
      <a
        href={data.cta_href}
        class="inline-flex items-center gap-2 px-8 py-4 bg-accent-500 hover:bg-accent-400 text-light-50 rounded-xl text-lg font-semibold transition-all hover:scale-105 hover:shadow-lg hover:shadow-accent-500/25"
      >
        {data.cta_button}
      </a>
    </div>
  </section>

</Layout>
