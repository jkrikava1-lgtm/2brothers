---
import Layout from '../layouts/Layout.astro';
import data from '../data/homepage.json';
---

<Layout title={data.meta_title} description={data.meta_description}>

  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
    <!-- Animated gradient background -->
    <div class="absolute inset-0 bg-night-950"></div>
    <!-- Glow orbs -->
    <div class="absolute top-1/3 left-1/6 w-[500px] h-[500px] bg-pink-500/20 rounded-full blur-[120px] animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/6 w-[400px] h-[400px] bg-cyan-400/15 rounded-full blur-[100px] animate-pulse" style="animation-delay: 1s;"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-purple-500/10 rounded-full blur-[80px] animate-pulse" style="animation-delay: 2s;"></div>

    <div class="relative max-w-4xl mx-auto px-4 text-center py-20">
      <img src="/images/hero/dj-duo.gif" alt="2Brothers DJ Duo" class="mx-auto mb-10 w-full max-w-2xl rounded-3xl drop-shadow-[0_0_40px_rgba(255,26,126,0.3)]" />

      <h1 class="text-4xl sm:text-6xl lg:text-8xl font-display font-900 mb-6 leading-none whitespace-nowrap">
        <span class="bg-gradient-to-r from-pink-400 via-purple-300 to-cyan-400 bg-clip-text text-transparent">
          {data.hero_headline}
        </span>
      </h1>
      <p class="text-xl lg:text-2xl text-white/60 mb-12 max-w-2xl mx-auto">
        {data.hero_subheadline}
      </p>
      <a
        href={data.hero_cta_href}
        class="group inline-flex items-center gap-3 px-10 py-5 bg-gradient-to-r from-pink-500 to-purple-500 hover:from-pink-400 hover:to-purple-400 text-white rounded-full text-lg font-bold transition-all hover:scale-110 hover:shadow-[0_0_40px_rgba(255,26,126,0.4)]"
      >
        {data.hero_cta}
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- About preview -->
  <section class="py-24 lg:py-32 relative">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-4xl lg:text-5xl font-display mb-8">{data.about_headline}</h2>
        <p class="text-lg text-white/60 leading-relaxed mb-10">{data.about_text}</p>
        <a href={data.about_cta_href} class="inline-flex items-center gap-2 text-pink-400 hover:text-pink-300 font-bold text-lg transition-colors">
          {data.about_cta}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-24 lg:py-32 relative overflow-hidden">
    <div class="absolute inset-0 bg-night-950"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-pink-500/10 rounded-full blur-[100px]"></div>
    <div class="absolute bottom-0 left-0 w-72 h-72 bg-cyan-400/10 rounded-full blur-[80px]"></div>

    <div class="relative max-w-6xl mx-auto px-4">
      <h2 class="text-4xl lg:text-5xl font-display text-center mb-16">{data.services_headline}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {data.services.map((service, i) => (
          <div class:list={[
            'group p-8 rounded-3xl border transition-all hover:scale-[1.02] hover:-translate-y-1',
            i === 0 && 'bg-gradient-to-br from-pink-500/10 to-pink-500/5 border-pink-500/20 hover:border-pink-500/40 hover:shadow-[0_0_30px_rgba(255,26,126,0.15)]',
            i === 1 && 'bg-gradient-to-br from-cyan-400/10 to-cyan-400/5 border-cyan-400/20 hover:border-cyan-400/40 hover:shadow-[0_0_30px_rgba(0,229,223,0.15)]',
            i === 2 && 'bg-gradient-to-br from-purple-400/10 to-purple-400/5 border-purple-400/20 hover:border-purple-400/40 hover:shadow-[0_0_30px_rgba(168,85,247,0.15)]',
            i === 3 && 'bg-gradient-to-br from-neon-300/10 to-neon-300/5 border-neon-300/20 hover:border-neon-300/40 hover:shadow-[0_0_30px_rgba(230,240,0,0.15)]',
          ]}>
            <div class:list={[
              'w-14 h-14 rounded-2xl flex items-center justify-center mb-6',
              i === 0 && 'bg-pink-500/20',
              i === 1 && 'bg-cyan-400/20',
              i === 2 && 'bg-purple-400/20',
              i === 3 && 'bg-neon-300/20',
            ]}>
              {service.icon === 'heart' && (
                <svg class="w-7 h-7 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              )}
              {service.icon === 'cake' && (
                <svg class="w-7 h-7 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0A1.75 1.75 0 013 15.546V12a9 9 0 0118 0v3.546zM12 4v1m-4 1l.5-.87M16 6l-.5-.87" />
                </svg>
              )}
              {service.icon === 'briefcase' && (
                <svg class="w-7 h-7 text-purple-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.193 23.193 0 0112 15c-3.183 0-6.22-.64-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              {service.icon === 'music' && (
                <svg class="w-7 h-7 text-neon-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                </svg>
              )}
            </div>
            <h3 class="text-2xl font-display font-800 mb-3">{service.title}</h3>
            <p class="text-white/50 leading-relaxed">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Equipment -->
  <section class="py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl lg:text-5xl font-display text-center mb-16">{data.equipment_headline}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-3xl mx-auto">
        {data.equipment_items.map((item, i) => (
          <div class="flex items-center gap-3 p-5 rounded-2xl bg-white/5 border border-white/10 hover:border-pink-500/30 transition-all">
            <svg class:list={[
              'w-5 h-5 shrink-0',
              i % 3 === 0 && 'text-pink-400',
              i % 3 === 1 && 'text-cyan-400',
              i % 3 === 2 && 'text-neon-300',
            ]} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-sm text-white/80 font-medium">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 lg:py-32 relative overflow-hidden">
    <div class="absolute inset-0 bg-night-950"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-pink-500/10 rounded-full blur-[150px]"></div>

    <div class="relative max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-4xl lg:text-5xl font-display mb-8">{data.cta_headline}</h2>
      <p class="text-lg text-white/60 mb-12">{data.cta_text}</p>
      <a
        href={data.cta_href}
        class="inline-flex items-center gap-3 px-10 py-5 bg-gradient-to-r from-pink-500 to-purple-500 hover:from-pink-400 hover:to-purple-400 text-white rounded-full text-lg font-bold transition-all hover:scale-110 hover:shadow-[0_0_50px_rgba(255,26,126,0.4)]"
      >
        {data.cta_button}
      </a>
    </div>
  </section>

</Layout>
