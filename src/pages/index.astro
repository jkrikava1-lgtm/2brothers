---
import Layout from '../layouts/Layout.astro';
import data from '../data/homepage.json';
---

<Layout title={data.meta_title} description={data.meta_description}>

  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
    <div class="relative max-w-5xl mx-auto px-4 text-center py-12">
      <!-- Hero image fading into background -->
      <div class="relative mb-10" style="mask-image: radial-gradient(ellipse 85% 75% at center, black 25%, transparent 75%), linear-gradient(to right, transparent, black 15%, black 85%, transparent), linear-gradient(to bottom, transparent, black 15%, black 85%, transparent); mask-composite: intersect; -webkit-mask-image: radial-gradient(ellipse 85% 75% at center, black 25%, transparent 75%), linear-gradient(to right, transparent, black 15%, black 85%, transparent), linear-gradient(to bottom, transparent, black 15%, black 85%, transparent); -webkit-mask-composite: source-in;">
        <img src="/images/hero/hero.jpg" alt="2Brothers DJ Duo" class="w-full block" />
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-8xl font-display font-900 leading-none whitespace-nowrap drop-shadow-[0_2px_20px_rgba(0,0,0,0.8)] -mt-20 relative z-10 mb-10">
        <span class="bg-gradient-to-r from-pink-400 via-purple-300 to-cyan-400 bg-clip-text text-transparent">
          {data.hero_headline}
        </span>
      </h1>
      <p class="text-xl lg:text-2xl text-white/60 mb-12 max-w-2xl mx-auto">
        {data.hero_subheadline}
      </p>
      <a
        href={data.hero_cta_href}
        class="group inline-flex items-center gap-3 px-10 py-5 bg-gradient-to-r from-pink-500 to-purple-500 hover:from-pink-400 hover:to-purple-400 text-white rounded-full text-lg font-bold transition-all hover:scale-110 hover:shadow-[0_0_40px_rgba(255,26,126,0.4)]"
      >
        {data.hero_cta}
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- About preview -->
  <section class="py-12 lg:py-16 relative">
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-4xl lg:text-5xl font-display mb-8">{data.about_headline}</h2>
        <p class="text-lg text-white/60 leading-relaxed mb-10">{data.about_text}</p>
        <a href={data.about_cta_href} class="inline-flex items-center gap-2 text-pink-400 hover:text-pink-300 font-bold text-lg transition-colors">
          {data.about_cta}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-4xl lg:text-5xl font-display text-center mb-16">{data.services_headline}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {data.services.map((service, i) => (
          <div class:list={[
            'group rounded-3xl border overflow-hidden transition-all hover:scale-[1.02] hover:-translate-y-1',
            i === 0 && 'border-pink-500/20 hover:border-pink-500/40 hover:shadow-[0_0_30px_rgba(255,26,126,0.15)]',
            i === 1 && 'border-cyan-400/20 hover:border-cyan-400/40 hover:shadow-[0_0_30px_rgba(0,229,223,0.15)]',
            i === 2 && 'border-purple-400/20 hover:border-purple-400/40 hover:shadow-[0_0_30px_rgba(168,85,247,0.15)]',
            i === 3 && 'border-neon-300/20 hover:border-neon-300/40 hover:shadow-[0_0_30px_rgba(230,240,0,0.15)]',
          ]}>
            <img src={[
              '/images/galerie/svatba-radkyne.jpg',
              '/images/galerie/oslava-sobotka.jpg',
              '/images/galerie/aparatura-valdice.jpg',
              '/images/galerie/akce-2024.jpg',
            ][i]} alt={service.title} class="w-full h-48 object-cover" loading="lazy" />
            <div class="p-6">
              <h3 class="text-2xl font-display font-800 mb-3">{service.title}</h3>
              <p class="text-white/50 leading-relaxed">{service.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Equipment -->
  <section class="py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-4xl lg:text-5xl font-display text-center mb-16">{data.equipment_headline}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-3xl mx-auto">
        {data.equipment_items.map((item, i) => (
          <div class="flex items-center gap-3 p-5 rounded-2xl bg-white/5 border border-white/10 hover:border-pink-500/30 transition-all">
            <svg class:list={[
              'w-5 h-5 shrink-0',
              i % 3 === 0 && 'text-pink-400',
              i % 3 === 1 && 'text-cyan-400',
              i % 3 === 2 && 'text-neon-300',
            ]} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-sm text-white/80 font-medium">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ročník 1976 -->
  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="p-8 lg:p-12 rounded-3xl border border-pink-500/30 bg-pink-500/5 shadow-[0_0_40px_rgba(255,26,126,0.1)]">
        <h2 class="text-3xl lg:text-5xl font-display font-900 mb-4 bg-gradient-to-r from-pink-400 to-cyan-400 bg-clip-text text-transparent">Ročníku 1976, pojď to oslavit s námi!</h2>
        <p class="text-xl lg:text-2xl text-white/70 font-medium">50 je jen jednou v životě a ten mejdan má bejt velkej!</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 lg:py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-4xl lg:text-5xl font-display mb-8">{data.cta_headline}</h2>
      <p class="text-lg text-white/60 mb-12">{data.cta_text}</p>
      <a
        href={data.cta_href}
        class="inline-flex items-center gap-3 px-10 py-5 bg-gradient-to-r from-pink-500 to-purple-500 hover:from-pink-400 hover:to-purple-400 text-white rounded-full text-lg font-bold transition-all hover:scale-110 hover:shadow-[0_0_50px_rgba(255,26,126,0.4)]"
      >
        {data.cta_button}
      </a>
    </div>
  </section>

</Layout>
