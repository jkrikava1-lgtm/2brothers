---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import data from '../data/kontakt.json';
---

<Layout title={data.meta_title} description={data.meta_description}>
  <PageHero title={data.hero_title} subtitle={data.hero_subtitle} />

  <section class="py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

        <!-- Contact info -->
        <div>
          <h2 class="text-2xl font-display mb-8">Kontaktní údaje</h2>

          <div class="space-y-6 mb-10">
            {data.contacts.map((contact) => (
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-accent-100 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="text-warm-950 font-medium">{contact.name}</p>
                  <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="text-accent-700 hover:text-accent-600 transition-colors">
                    {contact.phone}
                  </a>
                </div>
              </div>
            ))}
          </div>

          <!-- Email -->
          <div class="flex items-center gap-4 mb-10">
            <div class="w-12 h-12 rounded-xl bg-accent-100 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-warm-500 text-sm">E-mail</p>
              <a href={`mailto:${data.email}`} class="text-accent-700 hover:text-accent-600 transition-colors">
                {data.email}
              </a>
            </div>
          </div>

          <!-- Locations -->
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-accent-100 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-warm-500 text-sm">Působíme v oblasti</p>
              <p class="text-warm-800">{data.locations.join(' · ')}</p>
            </div>
          </div>
        </div>

        <!-- Contact form -->
        <div>
          <h2 class="text-2xl font-display mb-8">{data.form_headline}</h2>
          <form id="contact-form" class="space-y-5" method="POST" action="/api/kontakt">
            <div>
              <label for="name" class="block text-sm text-warm-600 mb-1.5">{data.form_fields.name}</label>
              <input type="text" name="name" id="name" required
                class="w-full px-4 py-3 rounded-xl bg-cream-100 border border-warm-200 text-warm-900 placeholder-warm-400 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="email" class="block text-sm text-warm-600 mb-1.5">{data.form_fields.email}</label>
                <input type="email" name="email" id="email" required
                  class="w-full px-4 py-3 rounded-xl bg-cream-100 border border-warm-200 text-warm-900 placeholder-warm-400 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors" />
              </div>
              <div>
                <label for="phone" class="block text-sm text-warm-600 mb-1.5">{data.form_fields.phone}</label>
                <input type="tel" name="phone" id="phone"
                  class="w-full px-4 py-3 rounded-xl bg-cream-100 border border-warm-200 text-warm-900 placeholder-warm-400 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="event_type" class="block text-sm text-warm-600 mb-1.5">{data.form_fields.event_type}</label>
                <select name="event_type" id="event_type"
                  class="w-full px-4 py-3 rounded-xl bg-cream-100 border border-warm-200 text-warm-900 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors">
                  <option value="">Vyberte...</option>
                  {data.event_types.map((type) => (
                    <option value={type}>{type}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="event_date" class="block text-sm text-warm-600 mb-1.5">{data.form_fields.event_date}</label>
                <input type="date" name="event_date" id="event_date"
                  class="w-full px-4 py-3 rounded-xl bg-cream-100 border border-warm-200 text-warm-900 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors" />
              </div>
            </div>
            <div>
              <label for="message" class="block text-sm text-warm-600 mb-1.5">{data.form_fields.message}</label>
              <textarea name="message" id="message" rows="4"
                class="w-full px-4 py-3 rounded-xl bg-cream-100 border border-warm-200 text-warm-900 placeholder-warm-400 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors resize-none"></textarea>
            </div>
            <button type="submit" id="submit-btn"
              class="w-full px-6 py-4 bg-accent-600 hover:bg-accent-500 text-white rounded-xl font-semibold transition-all hover:shadow-lg hover:shadow-accent-500/25">
              {data.form_button}
            </button>
          </form>

          <!-- Status messages -->
          <div id="form-success" class="hidden mt-4 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm">
            Děkujeme! Vaše poptávka byla odeslána. Ozveme se vám co nejdříve.
          </div>
          <div id="form-error" class="hidden mt-4 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm">
            Něco se pokazilo. Zkuste to prosím znovu nebo nám zavolejte.
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const success = document.getElementById('form-success');
  const error = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Odesílám...';
    success?.classList.add('hidden');
    error?.classList.add('hidden');

    try {
      const res = await fetch('/api/kontakt', {
        method: 'POST',
        body: new FormData(form),
      });

      if (res.ok) {
        form.reset();
        success?.classList.remove('hidden');
      } else {
        error?.classList.remove('hidden');
      }
    } catch {
      error?.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Odeslat poptávku';
    }
  });
</script>
