---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import novinky from '../data/novinky.json';

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout title="Novinky – 2Brothers Music Factory" description="Aktuality a nadcházející akce od 2Brothers Music Factory.">
  <PageHero title="Novinky" subtitle="Aktuální akce a termíny" video="/videos/animace-novinky.mp4" />

  <section class="py-10 lg:py-14">
    <div class="max-w-3xl mx-auto px-4">
      <div class="space-y-8">
        {novinky.map((item, i) => (
          <article class:list={[
            'rounded-3xl border overflow-hidden transition-all hover:scale-[1.01]',
            i % 3 === 0 && 'bg-pink-500/5 border-pink-500/20 hover:shadow-[0_0_30px_rgba(255,26,126,0.1)]',
            i % 3 === 1 && 'bg-cyan-400/5 border-cyan-400/20 hover:shadow-[0_0_30px_rgba(0,229,223,0.1)]',
            i % 3 === 2 && 'bg-purple-400/5 border-purple-400/20 hover:shadow-[0_0_30px_rgba(168,85,247,0.1)]',
          ]}>
            {item.image && (
              <img src={item.image} alt={item.title} class="w-full max-h-96 object-contain bg-night-900" loading="lazy" />
            )}
            <div class="p-6 lg:p-8">
              <time class:list={[
                'text-sm font-bold',
                i % 3 === 0 && 'text-pink-400',
                i % 3 === 1 && 'text-cyan-400',
                i % 3 === 2 && 'text-purple-300',
              ]}>{formatDate(item.date)}</time>
              <h2 class="text-xl font-display font-800 mt-2 mb-3">{item.title}</h2>
              <p class="text-white/50 leading-relaxed">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
