---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const novinky = [
  {
    title: "Majáles v Kovači",
    date: "2025-05-17",
    description: "Přijďte se bavit na další naši diskotéku v Kovači! Start ve 20:00, na tančení je místo vždy. Rezervace míst k sezení na telefonu.",
    image: "/images/novinky/majales.jpg",
  },
  {
    title: "Jarní diskotéka v Kovači",
    date: "2025-03-22",
    description: "Jarní diskotéka v Kovači — přijďte oslavit příchod jara s 2Brothers!",
    image: "/images/novinky/jarni-kovac.jpg",
  },
  {
    title: "Valentýnská diskotéka",
    date: "2025-02-14",
    description: "Slavte Valentýna s námi na speciální valentýnské diskotéce v Kovači.",
    image: "/images/novinky/valentyn.jpg",
  },
  {
    title: "1. diskotéka 2025",
    date: "2025-01-18",
    description: "První diskotéka nového roku! Přijďte oslavit začátek roku 2025.",
    image: "/images/novinky/disco-2025.jpg",
  },
  {
    title: "Štěpánská diskotéka",
    date: "2024-12-26",
    description: "Tradiční štěpánská diskotéka v Kovači. Přijďte si zatancovat po Vánocích!",
    image: "/images/novinky/stepanska.jpg",
  },
  {
    title: "Vánoční párty",
    date: "2024-12-14",
    description: "Předvánoční diskotéka — rozlučte se s rokem ve velkém stylu!",
    image: "/images/novinky/vanocni.jpg",
  },
  {
    title: "Diskotéka v Kovači",
    date: "2024-11-09",
    description: "Listopadová diskotéka v Kovači. Na tančení je místo vždy!",
    image: "/images/novinky/disco-11-2024.jpg",
  },
  {
    title: "Diskotéka v Kovači",
    date: "2024-05-11",
    description: "Májová diskotéka v Kovači — přijďte se bavit s 2Brothers!",
    image: "/images/novinky/plakat-kovac.jpg",
  },
];

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout title="Novinky – 2Brothers Music Factory" description="Aktuality a nadcházející akce od 2Brothers Music Factory.">
  <PageHero title="Novinky" subtitle="Aktuální akce a termíny" />

  <section class="py-16 lg:py-24">
    <div class="max-w-3xl mx-auto px-4">
      <div class="space-y-6">
        {novinky.map((item) => (
          <article class="rounded-2xl bg-cream-100 border border-warm-200/60 overflow-hidden shadow-sm">
            {item.image && (
              <img src={item.image} alt={item.title} class="w-full max-h-96 object-contain bg-cream-200" loading="lazy" />
            )}
            <div class="p-6 lg:p-8">
              <time class="text-sm text-accent-700 font-medium">{formatDate(item.date)}</time>
              <h2 class="text-xl font-display font-700 mt-2 mb-3">{item.title}</h2>
              <p class="text-warm-600 leading-relaxed">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
