---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const videos = [
  { src: "/videos/jirka-platno.mp4", title: "Jirka s plátnem" },
  { src: "/videos/dj-kid.mp4", title: "DJ Kid" },
  { src: "/videos/platno-text.mp4", title: "Plátno v akci" },
  { src: "/videos/pred-svatbou.mp4", title: "Před svatbou" },
  { src: "/videos/svetla.mp4", title: "Světelná show" },
];

const photos = [
  { src: "/images/galerie/svatebni-areal.jpg", alt: "Svatební areál Radkyně" },
  { src: "/images/galerie/nevesta-radkyne.jpg", alt: "Nevěsta v Radkyni" },
  { src: "/images/galerie/svatba-radkyne.jpg", alt: "Svatba Radkyně" },
  { src: "/images/galerie/oslava-sobotka.jpg", alt: "Oslava narozenin Sobotka" },
  { src: "/images/galerie/oslava-rohatsko.jpg", alt: "Oslava narozenin Rohatsko" },
  { src: "/images/galerie/hokej-na-platne.jpg", alt: "Hokejový zápas na plátně" },
  { src: "/images/galerie/aparatura-valdice.jpg", alt: "Aparatura na oslavě Valdice" },
  { src: "/images/galerie/vyjezdni-stan.jpg", alt: "Výjezdní stan" },
  { src: "/images/galerie/akce-2024.jpg", alt: "Akce 2024" },
  { src: "/images/galerie/akce-2023.jpg", alt: "Akce 2023" },
  { src: "/images/galerie/akce-foto.jpg", alt: "Akce 2Brothers" },
];
---

<Layout title="Galerie – 2Brothers Music Factory" description="Fotogalerie z akcí 2Brothers Music Factory.">
  <PageHero title="Galerie" subtitle="Fotky a videa z našich akcí, svateb a oslav" video="/videos/animace-galerie.mp4" />

  <!-- Videa -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-display text-center mb-10">Videa z akcí</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        {videos.map((video, i) => (
          <div class:list={[
            'rounded-3xl overflow-hidden border',
            i % 3 === 0 && 'border-pink-500/20',
            i % 3 === 1 && 'border-cyan-400/20',
            i % 3 === 2 && 'border-purple-400/20',
          ]}>
            <video
              class="w-full aspect-[9/16] object-cover"
              src={video.src}
              poster=""
              controls
              preload="metadata"
              playsinline
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fotky -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-display text-center mb-10">Fotky z akcí</h2>
      <div class="columns-1 md:columns-2 lg:columns-3 gap-4 space-y-4">
        {photos.map((photo, i) => (
          <div class:list={[
            'break-inside-avoid rounded-3xl overflow-hidden border transition-all hover:scale-[1.02]',
            i % 3 === 0 && 'border-pink-500/20 hover:shadow-[0_0_30px_rgba(255,26,126,0.15)]',
            i % 3 === 1 && 'border-cyan-400/20 hover:shadow-[0_0_30px_rgba(0,229,223,0.15)]',
            i % 3 === 2 && 'border-purple-400/20 hover:shadow-[0_0_30px_rgba(168,85,247,0.15)]',
          ]}>
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full block cursor-pointer"
              loading="lazy"
              data-lightbox
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-sm items-center justify-center p-4 cursor-pointer" style="display:none;">
  <button id="lb-close" class="absolute top-4 right-4 text-white/80 hover:text-white text-4xl font-bold z-10">&times;</button>
  <button id="lb-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white/60 hover:text-white text-5xl z-10">&#8249;</button>
  <button id="lb-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/60 hover:text-white text-5xl z-10">&#8250;</button>
  <img id="lb-img" class="max-h-[90vh] max-w-[90vw] object-contain rounded-2xl" src="" alt="" />
</div>

<script>
  const lightbox = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const images = Array.from(document.querySelectorAll('[data-lightbox]')) as HTMLImageElement[];
  let current = 0;

  function show(idx: number) {
    current = idx;
    lbImg.src = images[idx].src;
    lbImg.alt = images[idx].alt;
    lightbox.style.display = 'flex';
  }

  images.forEach((img, i) => {
    img.addEventListener('click', () => show(i));
  });

  document.getElementById('lb-close')!.addEventListener('click', (e) => {
    e.stopPropagation();
    lightbox.style.display = 'none';
  });

  document.getElementById('lb-prev')!.addEventListener('click', (e) => {
    e.stopPropagation();
    show((current - 1 + images.length) % images.length);
  });

  document.getElementById('lb-next')!.addEventListener('click', (e) => {
    e.stopPropagation();
    show((current + 1) % images.length);
  });

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.style.display = 'none';
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox.style.display === 'none') return;
    if (e.key === 'Escape') lightbox.style.display = 'none';
    if (e.key === 'ArrowLeft') show((current - 1 + images.length) % images.length);
    if (e.key === 'ArrowRight') show((current + 1) % images.length);
  });
</script>
