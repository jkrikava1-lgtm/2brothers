---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Galerie – 2Brothers Music Factory" description="Fotogalerie z akcí 2Brothers Music Factory.">
  <PageHero title="Galerie" subtitle="Fotky z našich akcí a diskotéky" />

  <section class="py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <!-- Placeholder - fotky se doplní -->
      <div class="text-center py-20">
        <div class="w-20 h-20 rounded-2xl bg-dark-800 border border-dark-700/50 flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-light-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <p class="text-light-400 text-lg">Fotogalerie se připravuje.</p>
        <p class="text-light-400/60 text-sm mt-2">Brzy zde najdete fotky z našich akcí.</p>
      </div>
    </div>
  </section>
</Layout>
