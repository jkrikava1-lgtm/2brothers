{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=60"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/novinky-a-kde-hrajeme", "destination": "/novinky", "permanent": true },
    { "source": "/novinky-a-kde-hrajeme/", "destination": "/novinky", "permanent": true },
    { "source": "/galeryje", "destination": "/galerie", "permanent": true },
    { "source": "/galeryje/", "destination": "/galerie", "permanent": true },
    { "source": "/kontakty", "destination": "/kontakt", "permanent": true },
    { "source": "/kontakty/", "destination": "/kontakt", "permanent": true }
  ]
}
